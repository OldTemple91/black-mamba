{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "black-mamba-slo",
  "title": "Black Mamba — SLO & Error Budget",
  "tags": ["slo", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "links": [
    {"title": "Overview", "url": "/d/black-mamba-overview", "type": "link", "targetBlank": false},
    {"title": "Route Performance", "url": "/d/black-mamba-route-performance", "type": "link", "targetBlank": false}
  ],
  "panels": [
    {
      "type": "stat",
      "title": "🎯 가용성 SLO (target: 99%)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "id": 1,
      "targets": [
        {
          "expr": "slo:navigation_availability:ratio30d",
          "legendFormat": "30일 가용성",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 0.985},
              {"color": "green",  "value": 0.99}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "⏱ 지연 SLO p95 (target: <2s)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "id": 2,
      "targets": [
        {
          "expr": "slo:route_duration_p95:5m",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 1.5},
              {"color": "red",    "value": 2}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "🔥 Fast Burn (1h, 임계 14.4×)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
      "id": 3,
      "targets": [
        {
          "expr": "slo:navigation_errorbudget_burnrate:1h",
          "legendFormat": "1h burn rate",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 6},
              {"color": "red",    "value": 14.4}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "🔥 Slow Burn (6h, 임계 6×)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "id": 4,
      "targets": [
        {
          "expr": "slo:navigation_errorbudget_burnrate:6h",
          "legendFormat": "6h burn rate",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 3},
              {"color": "red",    "value": 6}
            ]
          }
        }
      }
    },

    {
      "type": "timeseries",
      "title": "실시간 가용성 (5분 이동평균)",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "id": 10,
      "targets": [
        {
          "expr": "slo:navigation_availability:ratio5m",
          "legendFormat": "가용성",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "vector(0.99)",
          "legendFormat": "SLO target (99%)",
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1.0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },

    {
      "type": "timeseries",
      "title": "지연 분위수 (p95 / p99)",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "id": 11,
      "targets": [
        {
          "expr": "slo:route_duration_p95:5m",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "slo:route_duration_p99:5m",
          "legendFormat": "p99",
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "vector(2)",
          "legendFormat": "SLO target (2s)",
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    },

    {
      "type": "timeseries",
      "title": "Burn Rate 추이 (1h / 6h)",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 8},
      "id": 12,
      "targets": [
        {
          "expr": "slo:navigation_errorbudget_burnrate:1h",
          "legendFormat": "1h burn",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "slo:navigation_errorbudget_burnrate:6h",
          "legendFormat": "6h burn",
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "vector(14.4)",
          "legendFormat": "Fast Burn 임계 (14.4×)",
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "vector(6)",
          "legendFormat": "Slow Burn 임계 (6×)",
          "refId": "D",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "description": "Google SRE Workbook 표준 — fast burn(1h 14.4×)이 2분 지속 → critical alert. slow burn(6h 6×)이 15분 지속 → warning."
    },

    {
      "type": "stat",
      "title": "🔔 현재 활성 알람",
      "gridPos": {"x": 0, "y": 21, "w": 6, "h": 5},
      "id": 20,
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"})",
          "legendFormat": "firing",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red",    "value": 3}
            ]
          }
        }
      }
    },

    {
      "type": "table",
      "title": "🔔 알람 상세",
      "gridPos": {"x": 6, "y": 21, "w": 18, "h": 10},
      "id": 21,
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"showHeader": true},
      "description": "현재 fire 상태인 알람 리스트. 평상시엔 비어있음."
    },

    {
      "type": "timeseries",
      "title": "🖥 컨테이너 CPU (cAdvisor)",
      "gridPos": {"x": 0, "y": 31, "w": 12, "h": 8},
      "id": 30,
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "🖥 컨테이너 Memory (cAdvisor)",
      "gridPos": {"x": 12, "y": 31, "w": 12, "h": 8},
      "id": 31,
      "targets": [
        {
          "expr": "sum by (name) (container_memory_usage_bytes{name=~\".+\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    }
  ]
}

        {
          "expr": "histogram_quantile(0.95, sum(rate(external_api_tmap_route_seconds_bucket[5m])) by (le)) * 1000",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",

      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(external_api_ddareungi_nearby_seconds_bucket[5m])) by (le)) * 1000",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"},

      "targets": [
        { "expr": "sum(rate(navigation_mobility_fallback_total[1m])) by (mobility, reason)", "legendFormat": "{{mobility}} - {{reason}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "HTTP 요청 응답시간 (by URI)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "id": 9,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (uri, le)) * 1000", "legendFormat": "{{uri}} p95", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "timeseries",
      "title": "JVM GC Pause",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "id": 10,
      "targets": [
        { "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m])) by (action, cause) * 1000", "legendFormat": "{{action}} - {{cause}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ],

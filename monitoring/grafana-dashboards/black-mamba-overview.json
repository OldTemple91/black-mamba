  "panels": [
    {
      "type": "stat",
      "title": "총 경로 탐색 요청 수",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "id": 1,
      "targets": [
        { "expr": "sum(increase(navigation_route_duration_seconds_count[5m]))", "legendFormat": "최근 5분", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "경로 탐색 p95 응답시간",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "id": 2,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(navigation_route_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95 (ms)", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 2000 },
            { "color": "red", "value": 5000 }
          ]}
        }
      }
    },
    {
      "type": "stat",
      "title": "캐시 Hit률",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "id": 3,
      "targets": [
        { "expr": "sum(rate(navigation_cache_total{result=\"hit\"}[5m])) / sum(rate(navigation_cache_total[5m]))", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.8 }
          ]}
        }
      }
    },
    {
      "type": "stat",
      "title": "JVM 힙 사용량",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "id": 4,
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"})", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "경로 탐색 응답시간 (p50/p95/p99)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "id": 5,
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(navigation_route_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(navigation_route_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(navigation_route_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "p99", "refId": "C" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
    },
    {
      "type": "timeseries",
      "title": "경로 탐색 처리량 (Mode × Preference)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "id": 6,
      "targets": [
        { "expr": "sum(rate(navigation_route_duration_seconds_count[1m])) by (mode, preference)", "legendFormat": "{{mode}} / {{preference}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "캐시 hit/miss (by cache)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "id": 7,
      "targets": [
        { "expr": "sum(rate(navigation_cache_total[1m])) by (cache, result)", "legendFormat": "{{cache}} - {{result}}", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "외부 API 호출 (폴백 발생율)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },

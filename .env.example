# === Black Mamba API Keys ===
# 아래 값을 실제 키로 교체 후 .env로 복사하세요.
# cp .env.example .env

ODSAY_API_KEY=your_odsay_key
DDAREUNGI_API_KEY=your_ddareungi_key
TAGO_API_KEY=your_tago_key
TMAP_APP_KEY=your_tmap_key
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# === Observability ===
# Grafana 관리자 비밀번호 (필수 — 미설정 시 docker compose 기동 실패)
GRAFANA_ADMIN_PASSWORD=change-me

# (선택) Discord 알림 웹훅 — Alertmanager 가 SLO/Burn Rate 알림 전송
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

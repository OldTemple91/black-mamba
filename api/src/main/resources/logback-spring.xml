<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 로컬 개발용: 콘솔 출력 (traceId/spanId 포함) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-} spanId=%X{spanId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Phase 2: Loki 로그 Push (Docker 환경에서만 활성화) -->
    <springProfile name="docker">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>http://loki:3100/loki/api/v1/push</url>
            </http>
            <format>
                <label>
                    <pattern>app=black-mamba,host=${HOSTNAME:-unknown},level=%level</pattern>
                    <readMarkers>true</readMarkers>
                </label>
                <message>
                    <!--
                         Loki 로그 한 건 = 한 줄(한 엔트리)
                         %msg와 %ex에 개행/따옴표/백슬래시가 섞이면 JSON이 깨지거나 Grafana에서
                         펼치지 않아도 멀티라인으로 노출된다.
                         %replace로 제어문자를 이스케이프해 "접기/펼치기" 토글이 정상 동작하게 만든다.
                    -->
                    <pattern>
                        {"ts":"%d{ISO8601}","level":"%level","logger":"%logger","thread":"%thread","traceId":"%X{traceId:-}","spanId":"%X{spanId:-}","message":"%replace(%replace(%replace(%msg){'\\\\','\\\\\\\\'}){'"','\\\\"'}){'[\r\n]+','\\\\n'}","stackTrace":"%replace(%replace(%replace(%ex){'\\\\','\\\\\\\\'}){'"','\\\\"'}){'[\r\n\t]+','\\\\n'}"}
                    </pattern>
                </message>
            </format>
            <batchSize>100</batchSize>
            <batchTimeoutMs>10000</batchTimeoutMs>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <!-- 기본 프로필 (로컬) -->
    <springProfile name="!docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 네비게이션 도메인 로그 상세 -->
    <logger name="com.blackmamba.navigation" level="DEBUG"/>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 로컬 개발용: 콘솔 출력 (traceId/spanId + 전체 스택트레이스 포함) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-} spanId=%X{spanId:-}] - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!--
         Phase 2: Loki 로그 Push (loki4j 2.0.0 + Loki 3.7)
         주요 개념:
         - labels: 인덱스되는 라벨 (쿼리 필터용)
         - structuredMetadata: 인덱스 안 되지만 펼치기로 필드 조회 가능 (Loki 3.0+)
         - message: 목록에 표시되는 본문 (한 줄 권장)

         → 긴 스택트레이스는 structuredMetadata로 → Grafana에서 펼쳐야만 보임
    -->
    <springProfile name="docker">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>http://loki:3100/loki/api/v1/push</url>
            </http>
            <batch>
                <maxItems>100</maxItems>
                <timeoutMs>10000</timeoutMs>
            </batch>
            <!-- 스트림 식별용 라벨 (쿼리 필터) -->
            <labels>
                app=black-mamba
                host=${HOSTNAME:-unknown}
                level=%level
            </labels>
            <!--
                 Structured Metadata - 펼치기 시에만 노출
                 stack_trace에 스택트레이스를 넣되 줄바꿈을 \n 이스케이프해 엔트리 한 줄 유지
            -->
            <structuredMetadata>
                traceId=%mdc{traceId:-}
                spanId=%mdc{spanId:-}
                thread=%thread
                logger=%logger
                stack_trace=%replace(%xException){'[\r\n]+','\\n'}
            </structuredMetadata>
            <!-- 목록에 보이는 짧은 요약 -->
            <message>
                <pattern>%d{HH:mm:ss.SSS} | %-5level | traceId=%X{traceId:-} | %replace(%msg){'[\r\n]+','\\n'}</pattern>
            </message>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <!-- 기본 프로필 (로컬) -->
    <springProfile name="!docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.blackmamba.navigation" level="DEBUG"/>
</configuration>
